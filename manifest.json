{
  "manifest_version": 3,
  "name": "TektikUYAP",
  "version": "1.0.2",
  "description": "Avukat, Bilirkişi ve Vatandaş UYAP portallarında seçili dosyanın tüm evraklarını tek tıkla ZIP olarak indirir.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.uyap.gov.tr/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.uyap.gov.tr/*"
      ],
      "js": [
        "src/hook-loader.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.uyap.gov.tr/*"
      ],
      "js": [
        "src/defaults.js",
        "src/zip.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/hook.js"
      ],
      "matches": [
        "https://*.uyap.gov.tr/*"
      ]
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "TektikUYAP"
  },
  "options_page": "src/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}